# Frontend Environment Variables (Vite)
# Configure this in Netlify -> Site configuration -> Environment variables

# URL of the deployed backend Express API (do NOT include trailing slash)
# Example: https://api-inovix.onrender.com
VITE_API_URL=https://your-backend-api.onrender.com

# URL of WebSocket server (optional, defaults to VITE_API_URL host)
VITE_WS_URL=wss://your-backend-api.onrender.com
