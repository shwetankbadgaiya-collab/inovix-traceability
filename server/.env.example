# ===================================================
# INOVIX Backend Environment Variables Template
# ===================================================

# Server Port and Mode
PORT=5000
NODE_ENV=production

# Database Connection URL
# For Local Dev: DATABASE_URL="file:./dev.db"
# For Production PostgreSQL (Render, Neon, Supabase, Railway):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DATABASE_URL="file:./dev.db"

# JWT Authentication
# Generate a strong 32+ character random string for production
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_chars
JWT_EXPIRES_IN=7d

# Allowed Frontend Domain for CORS (Your Netlify site URL)
# Example: https://inovix-traceability.netlify.app
FRONTEND_URL=https://your-inovix-frontend.netlify.app

# IoT Simulator & Background Monitoring Frequency (milliseconds)
IOT_SIMULATOR_INTERVAL_MS=5000

# Automated Alert Thresholds
ALERT_TEMP_MAX=30
ALERT_TEMP_MIN=2
ALERT_HUMIDITY_MAX=70
ALERT_HUMIDITY_MIN=40
ALERT_BATTERY_LOW=20
ALERT_CONNECTIVITY_TIMEOUT_MIN=15
